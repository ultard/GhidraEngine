    find_dependency(libvips CONFIG)
    find_dependency(ffmpeg CONFIG)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GhidraEngineTargets.cmake")
check_required_components(GhidraEngine)
